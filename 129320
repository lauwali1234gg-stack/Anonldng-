        for form in forms:
            has_password = any(i["type"] == "password" for i in form["inputs"])
            if not has_password:
                continue
            found_login = True
            action = resolve_form_action(url, form["action"])
            if form_has_csrf(form):
                self.a(self.log, f"  [+] CSRF token present in form -> {action}")
            else:
                self.a(self.log, f"  [!!][MED] Password form WITHOUT CSRF token -> {action}")
                self.finding("MEDIUM", "CSRF", f"No CSRF token in password form {action}")
        if not found_login:
            self.a(self.log, "[i] No password forms found on this page")

    # ---------- Default credentials (light check) ----------
    def check_default_creds(self, url, forms):
        self.a(self.log, "\n[*] MODULE: Default Credential Check (light)")
        for form in forms:
            inputs = form["inputs"]
            user_f = next((i["name"] for i in inputs if i["type"] in ("text", "email", "username") and i["name"]), None)
            pass_f = next((i["name"] for i in inputs if i["type"] == "password" and i["name"]), None)
            if not (user_f and pass_f):
                continue
            action = resolve_form_action(url, form["action"])
            base_data = {i["name"]: i["value"] for i in inputs if i["name"]}
            # Baseline: random junk login to compare against
            junk = dict(base_data)
            junk[user_f] = "zx9q1nonexistent"
            junk[pass_f] = "zx9q1wrongpass!"
            _, _, jb = http_request(action, session=self.session, data=junk, method="POST")
            junk_len = len(jb)
            self.a(self.log, f"[i] Testing form -> {action} ({user_f}/{pass_f})")
            for user, pwd in DEFAULT_CREDS:
                test = dict(base_data)
                test[user_f] = user
                test[pass_f] = pwd
                s, h, body = http_request(action, session=self.session, data=test, method="POST")
                body_low = body.lower()
                redirected = s in (301, 302) or "location" in {k.lower() for k in h}
                err_signature = ("wrong password" in body_low or "invalid username" in body_low
                                 or "incorrect" in body_low)
                delta = abs(len(body) - junk_len)
                if redirected or (err_signature is False and delta > 150):
                    self.a(self.log, f"  [!!][HIGH] Possible default cred ACCEPTED: {user}:{pwd} "
                                     f"(HTTP {s}, delta={delta})")
                    self.finding("HIGH", "DefaultCreds", f"{user}:{pwd} on {action}")
                time.sleep(random.uniform(0.5, 1.0))
            self.a(self.log, "[i] Default cred check done for this form")

    # ---------- Open redirect ----------
    def check_open_redirect(self, url):
        self.a(self.log, "\n[*] MODULE: Open Redirect")
        params = extract_params(url)
        flat = dict(params)
        for p in REDIRECT_PARAMS:
            if p not in flat:
                flat[p] = ""
        found = False
        for param in flat:
            test = dict(flat)
            test[param] = REDIRECT_EVIL
            req = urllib.request.Request(build_url(url, test),
                                         headers={"User-Agent": random.choice(USER_AGENTS)})
            try:
                opener = urllib.request.build_opener(NoRedirect)
                resp = opener.open(req, timeout=TIMEOUT)
                loc = resp.headers.get("Location", "")
                if REDIRECT_EVIL in loc:
                    self.a(self.log, f"[!!][HIGH] Open redirect via '{param}' -> {loc}")
                    self.finding("HIGH", "OpenRedirect", f"{param} -> {loc}")
                    found = True
            except Exception:
                pass
        if not found:
            self.a(self.log, "[i] No open redirect detected")

    # ---------- Directory finder (session-aware, with bypass retry) ----------
    def check_dirs(self, url):
        self.a(self.log, "\n[*] MODULE: Directory & Sensitive File Discovery")
        root = urllib.parse.urlunparse(urllib.parse.urlparse(url)._replace(path="", query="", fragment=""))
        for d in DIRS:
            u = f"{root}/{d}"
            s, _, _, _ = http_bypass(u, session=self.session)
            if s in (200, 301, 403):
                self.a(self.dir_text, f"HTTP {s}  {u}")
                self.a(self.log, f"  [!] HTTP {s}: {u}")
                if d in (".env", ".git", "phpmyadmin", "backup", "server-status"):
                    self.finding("HIGH", "Directories", f"HTTP {s} {u}")
            time.sleep(random.uniform(0.1, 0.2))
        self.a(self.log, "[i] Directory module complete")

    # ---------- Port scan ----------
    def check_ports(self, url):
        self.a(self.log, "\n[*] MODULE: TCP Port Scan")
        hostname = urllib.parse.urlparse(url).hostname or ""
        open_ports = []
        lock = threading.Lock()
        def worker(port):
            try:
                with socket.create_connection((hostname, port), timeout=3):
                    with lock:
                        open_ports.append(port)
            except Exception:
                pass
        threads = [threading.Thread(target=worker, args=(p,), daemon=True) for p in PORTS]
        for t in threads:
            t.start()
        for t in threads:
            t.join(6)
        for p in sorted(open_ports):
            self.a(self.port_text, f"OPEN  {hostname}:{p}")
            self.a(self.log, f"  [!] OPEN: {hostname}:{p}")
            if p in (22, 3389, 3306, 6379, 21):
                self.finding("MEDIUM", "Ports", f"{hostname}:{p} exposed")
        if not open_ports:
            self.a(self.log, "[i] No open ports from test list")

    # ---------- Forms discovery ----------
    def discover_forms(self, url):
        self.a(self.log, "\n[*] MODULE: POST Form Discovery")
        _, _, body = http_request(url, session=self.session)
        forms = parse_forms(body)
        if not forms:
            self.a(self.log, "[i] No forms found on target page")
            return []
        for idx, form in enumerate(forms):
            self.a(self.forms_text, f"Form #{idx + 1}")
            self.a(self.forms_text, f"  method: {form['method']}")
            self.a(self.forms_text, f"  action: {resolve_form_action(url, form['action'])}")
            for i in form["inputs"]:
                self.a(self.forms_text, f"    input name={i['name']!r} type={i['type']} value={i['value']!r}")
            self.a(self.forms_text, f"  csrf: {'YES' if form_has_csrf(form) else 'NO'}")
            self.a(self.forms_text, "-" * 40)
            self.a(self.log, f"  [i] Form #{idx + 1}: {form['method']} "
                             f"{[i['name'] for i in form['inputs']]} "
                             f"csrf={'YES' if form_has_csrf(form) else 'NO'}")
        return forms

    # ================= ORCHESTRATOR =================
    def scan_all(self, target):
        try:
            self.a(self.log, f"[*] Scan started: {target}")
            headers, body = self.check_headers(target)
            self.check_server_info(headers)
            self.detect_waf(target)
            forms = self.discover_forms(target)
            self.check_csrf(target, forms)
            self.sqli_get(target)
            self.sqli_post(target, forms)
            self.xss_scan(target, forms)
            self.check_default_creds(target, forms)
            self.check_open_redirect(target)
            self.check_dirs(target)
            self.check_ports(target)
            highs = sum(1 for f in self.report["findings"] if f["severity"] == "HIGH")
            self.a(self.log, "\n" + "=" * 55)
            self.a(self.log, f"[✓] SCAN COMPLETE | findings={len(self.report['findings'])} | HIGH={highs}")
            self.a(self.log, "[i] Tap 'Export' to save the report (txt/json)")
        except Exception as e:
            self.a(self.log, f"[!] Scan error: {e}")


