# ------------------------------------------------------------------
# Session: cookie jar maintained across all requests (GET & POST)
# ------------------------------------------------------------------
class Session:
    def __init__(self):
        self.cookies = {}

    def update_from(self, headers):
        for k, v in headers.items():
            if k.lower() == "set-cookie":
                pair = v.split(";")[0]
                if "=" in pair:
                    n, val = pair.split("=", 1)
                    self.cookies[n.strip()] = val.strip()

    def header(self):
        return "; ".join(f"{k}={v}" for k, v in self.cookies.items())

    def has_cookies(self):
        return bool(self.cookies)


# ------------------------------------------------------------------
# Form parser: finds POST/GET forms, inputs, password fields, CSRF tokens
# ------------------------------------------------------------------
class FormParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.forms = []
        self.current = None

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if tag == "form":
            self.current = {"action": a.get("action", ""), "method": a.get("method", "GET").upper(), "inputs": []}
        elif tag == "input" and self.current is not None:
            self.current["inputs"].append({"name": a.get("name", ""),
                                           "type": a.get("type", "text"),
                                           "value": a.get("value", "")})
        elif tag == "textarea" and self.current is not None:
            self.current["inputs"].append({"name": a.get("name", ""), "type": "textarea", "value": ""})

    def handle_endtag(self, tag):
        if tag == "form" and self.current is not None:
            self.forms.append(self.current)
            self.current = None


def parse_forms(html):
    p = FormParser()
    try:
        p.feed(html)
    except Exception:
        pass
    return p.forms


def form_has_csrf(form):
    for i in form["inputs"]:
        if any(n in i["name"].lower() for n in CSRF_TOKEN_NAMES):
            return True
    return False


# ------------------------------------------------------------------
# HTTP core: UA rotation, gzip, retries, session cookies, bypass headers
# ------------------------------------------------------------------
def http_request(url, session=None, extra_headers=None, data=None, method="GET"):
    headers = {"User-Agent": random.choice(USER_AGENTS),
               "Accept": "*/*", "Accept-Encoding": "gzip", "Connection": "close"}
    if session and session.has_cookies():
        headers["Cookie"] = session.header()
    if extra_headers:
        headers.update(extra_headers)
    payload = None
    if data is not None:
        headers["Content-Type"] = "application/x-www-form-urlencoded"
        payload = urllib.parse.urlencode(data, doseq=True).encode()
    req = urllib.request.Request(url, headers=headers, method=method)
    for attempt in range(MAX_RETRIES + 1):
        try:
            with urllib.request.urlopen(req, data=payload, timeout=TIMEOUT, context=CTX) as r:
                raw = r.read()
                if r.headers.get("Content-Encoding") == "gzip":
                    try:
                        raw = gzip.GzipFile(fileobj=io.BytesIO(raw)).read()
                    except Exception:
                        pass
                rh = dict(r.headers)
                if session:
                    session.update_from(rh)
                return r.status, rh, raw.decode("utf-8", "ignore")
        except urllib.error.HTTPError as e:
            rh = dict(e.headers)
            if session:
                session.update_from(rh)
            return e.code, rh, e.read().decode("utf-8", "ignore")
        except Exception as e:
            if attempt == MAX_RETRIES:
                return 0, {}, str(e)
            time.sleep(0.5)


def http_bypass(url, session=None, data=None):
    """Retry cycling bypass headers until a WAF block rule (403/406/429) stops triggering."""
    last = (0, {}, "no attempts")
    for bh in BYPASS_HEADERS_POOL:
        s, h, b = http_request(url, session=session, extra_headers=bh, data=data)
        if s not in (403, 406, 429, 501):
            return s, h, b, bh
        last = (s, h, b)
        time.sleep(random.uniform(0.3, 0.8))
    return last + ({},)


def extract_params(url):
    q = urllib.parse.urlparse(url).query
    return {k: v[0] for k, v in urllib.parse.parse_qs(q, keep_blank_values=True).items()}


def build_url(url, new_params):
    p = urllib.parse.urlparse(url)
    q = urllib.parse.urlencode(new_params, doseq=True, quote_via=urllib.parse.quote)
    return urllib.parse.urlunparse(p._replace(query=q))


def resolve_form_action(base, action):
    if not action:
        return base
    return urllib.parse.urljoin(base, action)


def is_time_based(p):
    return "SLEEP" in p or "WAITFOR" in p


